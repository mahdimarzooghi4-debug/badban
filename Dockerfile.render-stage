# Opt-in combined Stage candidate; it does not relax the Vault or release gates.
FROM node:22-alpine AS web-builder
WORKDIR /build/web
COPY web/package.json ./
RUN npm install --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM python:3.12-slim AS runtime
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    BADBAN_WEB_DIST_DIR=/app/web-dist
WORKDIR /app
COPY pyproject.toml README.md ./
COPY src ./src
COPY alembic.ini ./
COPY migrations ./migrations
RUN pip install --upgrade pip && pip install .
COPY --from=web-builder /build/web/dist /app/web-dist
EXPOSE 8000
CMD ["sh", "-c", "exec uvicorn badban.api.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
